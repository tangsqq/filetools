{
    "name": "render/pdf-tool",
    "description": "PDF processing tool with Excel conversion support",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "tecnickcom/tcpdf": "^6.6",
        "phpoffice/phpspreadsheet": "^2.1",
        "ext-gd": "*",
        "ext-zip": "*",
        "ext-xml": "*",
        "ext-imagick": "*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "optimize-autoloader": true
}
